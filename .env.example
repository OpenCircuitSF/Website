# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
BASE_URL=https://opencircuitsf.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://opencircuit:CHANGE_ME_IN_PRODUCTION@localhost:5432/opencircuit?sslmode=disable

# ── WebAuthn ──────────────────────────────────────────────────────────────────
# RP ID is the apex so a passkey stays valid across apex and www. ORIGIN must be
# the host the browser is actually on. These two are NOT interchangeable — a
# mismatch between RP_ORIGIN and the browser's real origin fails the ceremony
# with an opaque error (CLAUDE.md §7).
WEBAUTHN_RP_ID=opencircuitsf.com
WEBAUTHN_RP_ORIGIN=https://www.opencircuitsf.com

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_random_64_char_hex_string

# ── AWS / SES ─────────────────────────────────────────────────────────────────
# No static credentials — the EC2 instance role provides them via the AWS
# SDK's default credential chain. Locally the chain falls back to
# ~/.aws/credentials.
AWS_REGION=us-west-2
SES_CONFIGURATION_SET=opencircuit-transactional
EMAIL_FROM=Open Circuit SF <hello@opencircuitsf.com>
EMAIL_REPLY_TO=hello@opencircuitsf.com
EMAIL_LIST_DOMAIN=lists.opencircuitsf.com
SES_INBOUND_BUCKET=opencircuitsf-inbound

# ── Sending ───────────────────────────────────────────────────────────────────
MAX_SEND_RATE=10          # messages/second, keep below the SES quota
SEND_BATCH_SIZE=50
SEND_WORKER_ENABLED=true  # false on a second instance to avoid double-sending

# ── Bootstrap ─────────────────────────────────────────────────────────────────
# Email of the first admin user. On first startup with no users in the DB,
# this address is pre-authorized as admin when it completes registration.
ADMIN_EMAIL=you@example.com
