# This file is the production template, not a reference (#0423). It is what
# production gets: docs/deployment.md's install step is literally
# `sudo cp .env.example /etc/opencircuit/config.env`. So values here should
# work as shipped wherever a working value is knowable and safe to publish —
# illustrative "e.g." values lose to real ones. `docs/configuration.md` is
# the reference: read it for the "why" behind a variable; keep this file's
# "what" correct enough to boot and send mail unedited.
#
# Two kinds of value deliberately do NOT follow "ship something that works":
#   - A secret or credential (SESSION_SECRET, DATABASE_URL's password) ships
#     blank or an obvious CHANGE_ME placeholder, never a real value — see
#     SESSION_SECRET below for why a blank fails loud instead of booting
#     insecurely.
#   - A value this specific deploy must supply itself (DATABASE_URL's host/
#     credentials, ADMIN_EMAIL) ships an obvious placeholder so the operator
#     notices it needs replacing, per docs/deployment.md's install step.
# Everything else below is production's actual value, with two deliberate
# exceptions: SES_SANDBOX ships the conservative `true` (production runs
# `false`), and SES_INBOUND_BUCKET names the bucket #0057 will create, which
# does not exist yet.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
# Drives every canonical URL: og:url, og:image, sitemap.xml <loc>, and the
# Sitemap: line in robots.txt (#0019/#0020). Must match the host the browser
# is actually on — the same warning WEBAUTHN_RP_ORIGIN carries below. The apex
# 301s to www in production (CLAUDE.md §7), so this must be the **www** form,
# never the apex, or every emitted URL advertises a link that immediately
# redirects.
BASE_URL=https://www.opencircuitsf.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://opencircuit:CHANGE_ME_IN_PRODUCTION@localhost:5432/opencircuit?sslmode=disable
# Backend selector. Only the literal value "json" selects internal/devstore,
# the in-memory dev backend that has no mailing list at all (CLAUDE.md §5).
# An empty/unset DATABASE_URL does NOT engage dev mode on its own — this is
# the only switch. Never "json" in production.
STORAGE=postgres

# ── WebAuthn ──────────────────────────────────────────────────────────────────
# RP ID is the apex so a passkey stays valid across apex and www. ORIGIN must be
# the host the browser is actually on. These two are NOT interchangeable — a
# mismatch between RP_ORIGIN and the browser's real origin fails the ceremony
# with an opaque error (CLAUDE.md §7).
WEBAUTHN_RP_ID=opencircuitsf.com
WEBAUTHN_RP_ORIGIN=https://www.opencircuitsf.com

# ── Sessions ──────────────────────────────────────────────────────────────────
# HMAC signing key for session cookies. Required, with no default — startup
# fails closed with "config: missing required variable SESSION_SECRET" if this
# is left blank, which is deliberate: a non-empty placeholder here would boot
# and sign real sessions with a key published in a public repository. Generate
# a real value with: openssl rand -hex 32
SESSION_SECRET=

# ── AWS / SES ─────────────────────────────────────────────────────────────────
# No static credentials — the EC2 instance role provides them via the AWS
# SDK's default credential chain. Locally the chain falls back to
# ~/.aws/credentials.
AWS_REGION=us-east-1
SES_CONFIGURATION_SET=opencircuit-transactional
# The From: address MUST sit on a verified SES identity — production's is
# the mailing. subdomain, never the apex, because the apex identity cannot
# send (docs/email-setup.md). This is that real, working value; do not
# "simplify" it back to the apex form for readability — that was #0423's
# defect, and the apex form fails every send. Forking this for a different
# domain? Verify the equivalent identity in SES first.
EMAIL_FROM=Open Circuit SF <contact@mailing.opencircuitsf.com>
EMAIL_REPLY_TO=contact@opencircuitsf.com
EMAIL_LIST_DOMAIN=lists.opencircuitsf.com
SES_INBOUND_BUCKET=opencircuitsf-inbound
# The single SNS topic ARN internal/sesnotify accepts SES bounce/complaint
# notifications from (#0037/#0107). A valid SNS signature only proves SNS
# sent a message, not that it came through OUR topic, so sesnotify also
# checks TopicArn against this value and rejects everything else. Left blank
# it isn't a boot failure — sesnotify just rejects every notification — but
# production must set it once the SNS topic exists (CLAUDE.md §10 item 2).
SES_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:378152330719:opencircuit-ses-events
# Set true only for local development against the Postgres path before SES
# domain verification/DKIM/production access is done (CLAUDE.md §10 item 2).
# Swaps in auth.NoOpMailer, which logs the verification/recovery link to
# stdout instead of sending it (#0027) — this is how #0008's manual passkey
# verification procedure reads the magic link locally. Leave unset/false in
# production: that path always uses the real SES v2 API mailer.
MAILER_NOOP=false
# No live AWS call anywhere in this codebase can detect sandbox status, so
# this is a manually-set flag: leave it true until AWS approves the SES
# production-access request (CLAUDE.md §10 item 2), then flip it to false.
# The admin overview dashboard (#0061) warns while this is true.
SES_SANDBOX=true

# ── Sending ───────────────────────────────────────────────────────────────────
MAX_SEND_RATE=10          # messages/second, keep below the SES quota
SEND_BATCH_SIZE=50
SEND_WORKER_ENABLED=true  # false on a second instance to avoid double-sending

# ── Bootstrap ─────────────────────────────────────────────────────────────────
# Email of the first admin user. On first startup with no users in the DB,
# this address is pre-authorized as admin when it completes registration.
ADMIN_EMAIL=you@example.com
