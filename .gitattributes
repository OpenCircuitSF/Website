# Normalize line endings to LF on commit
* text=auto eol=lf

# Go source
*.go text eol=lf

# SQL migrations
*.sql text eol=lf

# Svelte / TypeScript
*.svelte text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf

# Markdown and docs
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Mailing golden fixtures — genuinely CRLF-sensitive, not accidentally so.
# The plain-text alternative parts these compare against are built with
# literal "\r\n" (see internal/mailing/templates.go's renderText, RFC 5322
# mail body line endings), so the fixture bytes ARE the thing under test.
# Overrides the `* text=auto eol=lf` rule above, which was silently rewriting
# these on checkout — see internal/mailing/testdata/README.md and #0078.
internal/mailing/testdata/*.txt -text
