[Unit]
Description=Open Circuit SF nightly PostgreSQL and media backup
Documentation=https://github.com/brennanMKE/OpenCircuitSF
After=network.target postgresql.service
Wants=postgresql.service
# #0229: this is the half of the backup story that used to be missing —
# backup.sh already exits non-zero on failure (verified in #0062), and until
# this OnFailure= existed nothing consumed that exit code. See
# opencircuit-backup-alert.service and scripts/db/backup-alert.sh.
OnFailure=opencircuit-backup-alert.service

[Service]
Type=oneshot
# Runs as the postgres OS user so pg_dump uses peer authentication, matching
# backup.sh's own documented production path (BACKUP_RUN_AS=postgres, its
# default). Because this unit's User= already IS postgres, backup.sh's
# internal `sudo -u "$BACKUP_RUN_AS"` check becomes a same-user no-op — no
# passwordless-sudo grant is needed for this path.
User=postgres
Group=postgres

# scripts/db/backup.sh assumes it can find the project's .env two directories
# up (for its BACKUP_DATABASES fallback) when run from the repo checkout.
# Adjust this to wherever the repo actually lives on the box — CLAUDE.md §10
# item 6 records the real server layout as still undocumented; /opt/opencircuit
# mirrors ShortLinks' own /opt/shortlinks convention (its DEPLOYMENT.md) and is
# a placeholder until the real path is captured.
WorkingDirectory=/opt/opencircuit
ExecStart=/usr/bin/bash /opt/opencircuit/scripts/db/backup.sh
# #0434: a second oneshot ExecStart= runs after the first completes — systemd
# executes multiple ExecStart= lines in a Type=oneshot unit in order, and a
# non-zero exit from EITHER one marks the whole unit failed, so
# OnFailure=opencircuit-backup-alert.service (above) still fires for a media
# backup failure exactly as it does for a database one. Requires the SAME
# permission fix #0435 already needs for BACKUP_ROOT — see
# scripts/db/backup-media.sh's header for exactly what and why; nothing new
# beyond that is required to read /var/www/media (verified world-readable
# on the box, 2026-09-05).
ExecStart=/usr/bin/bash /opt/opencircuit/scripts/db/backup-media.sh

# BACKUP_DATABASES is REQUIRED, not optional tuning (#0236). scripts/db/backup.sh
# no longer defaults to any database name — with this commented out and no
# readable .env at WorkingDirectory, it used to fall through to the literal
# "shortlinks" (a different project's database, inherited when the script was
# ported from ShortLinks by #0001), silently backing up the wrong project or
# failing against a database that doesn't exist on this box. Leaving this
# commented out now makes the unit fail loudly instead — which is correct, but
# means backups never ran until someone noticed the failure. Set it explicitly.
Environment=BACKUP_DATABASES=opencircuit

# Optional overrides, uncomment/edit once the real box's layout is known:
#Environment=BACKUP_ROOT=/var/backups/postgres
#Environment=BACKUP_RETENTION_DAYS=14

# #0434: media backup config — MEDIA_SOURCE_DIR and MEDIA_BACKUP_RETENTION_DAYS
# default to /var/www/media and 14 days (falling back to BACKUP_RETENTION_DAYS
# above if that's the only one set); uncomment to override either
# independently.
#Environment=MEDIA_SOURCE_DIR=/var/www/media
#Environment=MEDIA_BACKUP_RETENTION_DAYS=14

# Hardening, mirroring opencircuit.service where it does not conflict with
# writing dumps under BACKUP_ROOT (default /var/backups/postgres).
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

# No [Install] section: this unit is triggered by opencircuit-backup.timer
# (enabled separately, see its own [Install]) and by manual
# `systemctl start opencircuit-backup.service` for testing — it is not meant
# to be enabled directly against a target.
