[Unit]
Description=Open Circuit SF service
Documentation=https://github.com/brennanMKE/OpenCircuitSF
# The service binds a TCP socket and talks to a local PostgreSQL instance, so it
# must come up after the network and after the database it depends on.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=opencircuit
Group=opencircuit

# Runtime configuration (DB DSN, port, SES credentials, secrets) is supplied by
# the operator-managed env file, not committed to source control.
EnvironmentFile=/etc/opencircuit/config.env

# Installed binary location (see DEPLOYMENT.md step 4: `sudo install -m 0755
# opencircuit /usr/local/bin/opencircuit`). The `serve` subcommand starts the
# HTTP server; it listens on 127.0.0.1:8080 behind the Apache reverse proxy.
ExecStart=/usr/local/bin/opencircuit serve

# Always bring the service back if it crashes; wait 5s between restarts.
Restart=on-failure
RestartSec=5

# Graceful shutdown (#0081, budget split in #0087): `opencircuit serve` now
# catches SIGTERM itself (cmd/opencircuit/main.go's mountAndServe —
# signal.Notify + http.Server.Shutdown + SubscribeHandler.Close) and drains
# in-flight work — including the async confirmation-email send queue #0026
# introduced — instead of the whole process disappearing mid-send.
# KillSignal=SIGTERM is systemd's default already; set explicitly so the
# pairing with the process's own handler is obvious from this file alone.
# TimeoutStopSec must exceed the SUM of cmd/opencircuit/main.go's
# shutdownServerTimeout (5s) and subscribeCloseTimeout (15s) — two
# independent budgets since #0087, not one shared 20s deadline, so systemd
# still needs to cover both back-to-back in the worst case — or systemd
# SIGKILLs the process before that sequence can finish on its own; 30s
# leaves 10s of slack over their 20s combined.
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening: run unprivileged with a minimal, read-only view of the host.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
