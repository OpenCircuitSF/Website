{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSESPutForUnsubscribeRule",
      "Effect": "Allow",
      "Principal": { "Service": "ses.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::opencircuitsf-inbound/unsubscribe/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "AWS_ACCOUNT_ID",
          "AWS:SourceArn": "arn:aws:ses:us-east-1:AWS_ACCOUNT_ID:receipt-rule-set/opencircuit-inbound:receipt-rule/unsubscribe"
        }
      }
    }
  ]
}
